{
  "name": "@aderaaaa/ai-sdk",
  "version": "0.2.0",
  "description": "OpenAI 兼容的极简 AI SDK，支持流式响应与工具调用",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "keywords": [
    "openai",
    "ai",
    "sdk",
    "llm",
    "chat",
    "streaming",
    "tool-calling"
  ],
  "license": "MIT",
  "author": "ader",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
